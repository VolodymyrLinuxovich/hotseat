{
  "name": "hotseat",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"vite\"",
    "server": "env -u ANTHROPIC_API_KEY -u OPENAI_API_KEY -u GEMINI_API_KEY node --env-file=.env server.js",
    "build": "vite build",
    "build:native": "bash native/build.sh",
    "test": "node --test tests/",
    "format": "prettier --write .",
    "check": "prettier --check . && npm run lint && node --test tests/",
    "research:companies": "env -u ANTHROPIC_API_KEY node --env-file=.env scripts/research-companies.js",
    "lint": "eslint src engine server.js api scripts tests eslint.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "express": "^5.3.0",
    "openai": "^6.49.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "vite": "^8.3.8"
  },
  "type": "module"
}
